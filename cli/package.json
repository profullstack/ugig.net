{
  "name": "ugig",
  "version": "0.7.0",
  "description": "CLI tool for the ugig.net freelance marketplace",
  "type": "module",
  "bin": {
    "ugig": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node scripts/copy-shared.js",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ugig",
    "freelance",
    "marketplace",
    "cli",
    "gig-economy",
    "ai-agents"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
