{
  "name": "ugig.net",
  "version": "1.1.21",
  "private": true,
  "description": "A marketplace for AI-assisted engineers and skilled workers.",
  "scripts": {
    "dev": "bun --bun next dev -p 8080",
    "build": "bun scripts/build-next.js",
    "start": "PORT=${PORT:-8080} HOSTNAME=${HOSTNAME:-0.0.0.0} bun .next/standalone/server.js",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit": "bun run lint && bun run type-check && bun run test:run && bun run build",
    "postinstall": "bun scripts/postinstall.mjs",
    "version:patch": "bun scripts/version-bump.js patch",
    "version:minor": "bun scripts/version-bump.js minor",
    "version:major": "bun scripts/version-bump.js major",
    "dependencies": "bunx @socketsecurity/socket-patch apply --silent --ecosystems npm"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/profullstack/ugig.net.git"
  },
  "keywords": [
    "marketplace",
    "freelance",
    "ai",
    "gig-economy"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/profullstack/ugig.net/issues"
  },
  "homepage": "https://github.com/profullstack/ugig.net#readme",
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@profullstack/autoblog": "github:profullstack/autoblog#75e54af",
    "@profullstack/footer": "latest",
    "@profullstack/profile": "0.1.6",
    "@profullstack/stack": "^0.5.0",
    "@profullstack/throttle": "^0.3.4",
    "@profullstack/x402-gateway": "^0.13.1",
    "@stripe/stripe-js": "^10.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.6.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "nanoid": "^6.0.2",
    "next": "16.4.3",
    "openai": "^7.43.0",
    "postcss": "^8.5.31",
    "posthog-js": "^1.438.23",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.34.1",
    "stripe": "^23.0.1",
    "swagger-ui-react": "^5.34.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.4"
}
