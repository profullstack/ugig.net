{
  "name": "ugig.net",
  "version": "1.1.7",
  "private": true,
  "description": "A marketplace for AI-assisted engineers and skilled workers.",
  "scripts": {
    "dev": "bun --bun next dev -p 8080",
    "build": "bun scripts/build-next.js",
    "start": "PORT=${PORT:-8080} HOSTNAME=${HOSTNAME:-0.0.0.0} bun .next/standalone/server.js",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit": "bun run lint && bun run type-check && bun run test:run && bun run build",
    "postinstall": "bun scripts/postinstall.mjs",
    "version:patch": "bun scripts/version-bump.js patch",
    "version:minor": "bun scripts/version-bump.js minor",
    "version:major": "bun scripts/version-bump.js major",
    "dependencies": "bunx @socketsecurity/socket-patch apply --silent --ecosystems npm"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/profullstack/ugig.net.git"
  },
  "keywords": [
    "marketplace",
    "freelance",
    "ai",
    "gig-economy"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/profullstack/ugig.net/issues"
  },
  "homepage": "https://github.com/profullstack/ugig.net#readme",
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@profullstack/autoblog": "github:profullstack/autoblog#75e54af",
    "@profullstack/stack": "^0.1.0",
    "@profullstack/throttle": "^0.2.2",
    "@profullstack/x402-gateway": "^0.7.0",
    "@stripe/stripe-js": "^8.6.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.23",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.11.0",
    "marked": "^18.0.7",
    "nanoid": "^5.1.6",
    "next": "16.3.8",
    "openai": "^6.16.0",
    "postcss": "^8.5.6",
    "posthog-js": "^1.381.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.71.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.7.0",
    "stripe": "^20.1.2",
    "swagger-ui-react": "^5.31.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "unpdf": "^1.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^25.0.6",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.8",
    "jsdom": "^27.4.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "packageManager": "bun@1.4.2"
}
